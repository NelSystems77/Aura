# Copia este archivo a .env (producción) o .env.local (desarrollo) y ajusta
# los valores. Ver README.md para instrucciones completas.

# --- Config pública de Firebase (segura de exponer en el cliente) ---
# Firebase Console → ⚙️ Configuración del proyecto → General → Tus apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aura-e7a0e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aura-e7a0e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aura-e7a0e.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=727315067021
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Solo desarrollo local: apuntar a los emuladores de Firebase ---
# Deja estas 3 líneas SOLO en tu .env.local, nunca en producción.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Administradores ---
# UIDs de Firebase Authentication autorizados a entrar a /admin, separados
# por coma. Se obtienen en Firebase Console → Authentication → Users.
ADMIN_UIDS=6LL9eSFiH9UBqkrqwuMPnagtgKI2,niFJXb9arkQFdIuF2g2kT3IVn0Z2

# --- Sitio ---
WHATSAPP_NUMBER=50687409343
SITE_URL=https://aura-e7a0e.web.app

NODE_ENV=production
