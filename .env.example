# Copia este archivo a .env y ajusta los valores antes de desplegar.

# Secreto usado para firmar la cookie de sesión del panel admin.
# Genera uno único y seguro, por ejemplo: openssl rand -hex 32
SESSION_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Credenciales del primer usuario administrador (solo se usan al correr `npm run db:seed`
# la primera vez; luego cambia la contraseña desde el panel /admin/ajustes).
ADMIN_EMAIL=admin@aura.com
ADMIN_PASSWORD=CambiaEsteClave123!

# Número de WhatsApp para recibir pedidos (formato internacional sin "+" ni espacios).
WHATSAPP_NUMBER=50687409343

# Ruta del archivo de base de datos SQLite (opcional, por defecto var/data/aura.db)
DB_PATH=./var/data/aura.db

NODE_ENV=production
